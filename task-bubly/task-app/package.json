{
  "name": "@bublys-org/task-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:bubly": "vite build -c vite.config.bubly.ts"
  },
  "dependencies": {
    "@bublys-org/bubble-layout-feature": "*",
    "@bublys-org/bubble-space-shell": "*",
    "@bublys-org/bubbles-ui": "*",
    "@bublys-org/state-management": "*",
    "@bublys-org/task-libs": "*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "modern-normalize": "^3.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "redux-persist": "^6.0.0",
    "styled-components": "5.3.6"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "build:bubly"
        ]
      },
      "build:bubly": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "^dev"
        ],
        "continuous": true
      }
    }
  }
}
