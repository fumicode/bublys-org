{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react", "react-dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2021", "DOM"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    {
      "path": "../../users-bubly/users-libs/tsconfig.lib.json"
    },
    {
      "path": "../../bublys-libs/domain-registry/tsconfig.lib.json"
    },
    {
      "path": "../../bublys-libs/world-line-graph/tsconfig.lib.json"
    },
    {
      "path": "../../bublys-libs/bubble-layout-feature/tsconfig.lib.json"
    }
  ]
}
