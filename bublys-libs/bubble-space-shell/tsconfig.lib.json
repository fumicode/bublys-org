{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../world-line-graph/tsconfig.lib.json"
    },
    {
      "path": "../domain-registry/tsconfig.lib.json"
    },
    {
      "path": "../bubble-layout-ui/tsconfig.lib.json"
    },
    {
      "path": "../bubble-layout-feature/tsconfig.lib.json"
    },
    {
      "path": "../bubble-layout/tsconfig.lib.json"
    }
  ]
}
