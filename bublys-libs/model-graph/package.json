{
  "name": "@bublys-org/model-graph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "dev": "tsc -b tsconfig.lib.json --watch",
    "generate": "node dist/lib/extract/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@bublys-org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extract": {
      "@bublys-org/source": "./src/lib/extract/index.ts",
      "types": "./dist/lib/extract/index.d.ts",
      "import": "./dist/lib/extract/index.js",
      "default": "./dist/lib/extract/index.js"
    }
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true
      }
    }
  }
}
