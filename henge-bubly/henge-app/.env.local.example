# このファイルを .env.local にコピーして、鍵を書く。
# .env.local は gitignore 済み。
# 鍵はブラウザに埋め込まれる（バックエンドなし）。公開するなら OpenAI 側で利用上限を低くしておく。
#
# ⚠️ リポジトリ直下の .env は **追跡されている**ので、そちらには書かないこと。

OPENAI_API_KEY=sk-

# 使うモデル。省略時も gpt-6.1-terra。
#
#   gpt-6-astra    $10 / $50   最高性能。ここでは過剰
#   gpt-6.1-sol     $2 / $10   astra に近い。質を上げたいとき
#   gpt-6.1-terra   $1 /  $5   高速・自然な日本語。既定はこれ
#   gpt-6-luna    $0.10 / $0.50  最安。語義や見立ての判断には力不足
#
# 単位は 1M トークンあたり。
HENGE_AI_MODEL=gpt-6.1-terra
